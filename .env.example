# ── Database (Vercel Postgres / Neon) ────────────────────────────────────────
# Pooled URL for runtime; unpooled (direct) URL for Prisma migrations/db push.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The backend's OAuth callback, e.g. https://the-dish-archive-back.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Comma-separated allowed SPA origins (first is used for post-login redirect).
FRONTEND_URL=http://localhost:4200,https://the-dish-archive.vercel.app

# ── Super admin bootstrap (mirrors the old handle_new_user email) ─────────────
SUPER_ADMIN_EMAILS=zshkarrr@gmail.com

# ── Images (Cloudinary — already provisioned on the-dish-archive-back) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI recipe generation (Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=15000
GEMINI_MAX_INPUT_LENGTH=6000
AI_RECIPE_DAILY_LIMIT=20

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JSON_BODY_LIMIT=2mb
